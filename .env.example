# 複製這個檔案改名為 .env，再填入你自己的值。
# .env 已列在 .gitignore，不會被上傳。不要把真正的 token 貼回這個 .example 檔。

# ── 必填：LINE Developers Console → 你的 Messaging API channel ──
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── 必填其一：老闆身分 ──
# 自己想一組認證碼。老闆用自己的 LINE 對官方帳號傳「我是老闆 認證碼」就會綁定。
BOT_OWNER_CLAIM_CODE=
# 已經知道老闆的 LINE userId 也可以直接填（U 開頭 33 碼）
BOT_OWNER_USER_ID=

# ── 選填 ──
BOT_HOST=127.0.0.1
BOT_PORT=18800
# FAQ 信心門檻（0～1），低於就交給 AI 或老闆
BOT_CONFIDENCE_THRESHOLD=0.55

# ── 選填：Claude 補答。不填就不會呼叫任何 AI ──
ANTHROPIC_API_KEY=
BOT_AI_MODEL=claude-sonnet-5-5
